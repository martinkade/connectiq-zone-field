<settings>
    <setting propertyKey="@Properties.metricType" title="@Strings.MetricTypeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.MetricHeartRate</listEntry>
            <listEntry value="1">@Strings.MetricPower</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.themeMode" title="@Strings.ThemeModeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ThemeModeAuto</listEntry>
            <listEntry value="1">@Strings.ThemeModeDark</listEntry>
            <listEntry value="2">@Strings.ThemeModeLight</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.userFtp" title="@Strings.FtpTitle">
        <settingConfig type="numeric" min="50" max="600" />
    </setting>
    <setting propertyKey="@Properties.decimalZone" title="@Strings.DisplayFormatTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.FormatDecimal</listEntry>
            <listEntry value="1">@Strings.FormatInteger</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.fullBackgroundColor" title="@Strings.ColorThemeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ColorThemeAccent</listEntry>
            <listEntry value="1">@Strings.ColorThemeFull</listEntry>
        </settingConfig>
    </setting>
</settings>
